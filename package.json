{
  "name": "wargame-server",
  "version": "1.0.0",
  "description": "台積電危機談判兵推 - Backend API Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "pg": "^8.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0",
    "socket.io-client": "^4.8.3"
  },
  "pkg": {
    "scripts": "game/autoplay-standalone.js",
    "assets": [
      "node_modules/engine.io-client/build/**",
      "node_modules/socket.io-client/build/**",
      "node_modules/ws/lib/**"
    ],
    "targets": [
      "node20-macos-arm64",
      "node20-macos-x64",
      "node20-win-x64",
      "node20-linux-x64"
    ],
    "outputPath": "game/dist"
  }
}
